#!/bin/bash
# ASO Companion setup for a Mac. Double-click this file (the first time: right-click it, choose Open, then Open).
# A Terminal window shows what is happening. Leave it open until it says "All done".
REPO="justkhalid/aso-companion"
DIR="$HOME/aso-companion"
LOG="/tmp/aso-setup.log"
: > "$LOG"
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never

say()  {
  case "$1" in
    "  "*) printf '   \033[32m\xe2\x9c\x93\033[0m %s\n' "${1#  }" ;;
    "") echo ;;
    *)  printf '\033[1;34m\xe2\x96\xb8\033[0m \033[1m%s\033[0m\n' "$1" ;;
  esac
  echo "$1" >> "$LOG"
}

# ---- a page in the browser that shows the progress, in the same look as the stories ----
PAGE="/tmp/aso-setup.html"
BG=''
LOGO=''
STAGES=("Check the token" "Install Git" "Install Node.js" "Download the app" "Install the app parts" "Build the app" "Put the icon on the Desktop")
STATE=(p p p p p p p)
MSG="Paste the GitHub token in the small window that asks for it."
DONE=0
PCT=0
render() {
  local rows="" i cls glyph cur=-1 curname="" cap=""
  for i in "${!STAGES[@]}"; do
    case "${STATE[$i]}" in d) cls=d; glyph="&#10003;";; a) cls=c; glyph="&#9679;"; cur=$i;; f) cls=f; glyph="&#10005;"; cur=$i;; *) cls=p; glyph="&#9675;";; esac
    rows="$rows<li class=$cls>$glyph</li>"
  done
  if [ "$cur" -ge 0 ]; then cap="STEP $((cur + 1)) OF ${#STAGES[@]}"; curname="${STAGES[$cur]}"; fi
  local refresh='<meta http-equiv="refresh" content="2">'
  [ "$DONE" = "1" ] && refresh=""
  cat > "$PAGE" <<HTML
<!doctype html><html><head><meta charset="utf-8">$refresh<title>ASO Companion setup</title><style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%}
body{background:#f3efe8 url(data:image/jpeg;base64,$BG) center top/cover no-repeat;min-height:100vh;font-family:-apple-system,"SF Pro Text","Helvetica Neue",sans-serif;color:#101830}
header{text-align:center;padding:34px 0 30px}
.badge{margin:0 auto}.badge img{width:60px}
h1{margin:18px 0 0;font-weight:800;font-size:36px;letter-spacing:-.015em;line-height:1.15}
h1 span{background:linear-gradient(95deg,#0a2463 0%,#1a56ff 55%,#d62839 100%);-webkit-background-clip:text;color:transparent;padding:0 2px}
.k{margin-top:12px;font-weight:700;font-size:11px;letter-spacing:.34em;padding-left:.34em;color:#d62839}
main{width:min(480px,90vw);margin:0 auto;padding:34px 0 40px;text-align:center}
p{margin:0 auto;color:#606a86;line-height:1.45;font-size:15px}
.bar{height:5px;border-radius:5px;background:#d6deee;margin:28px 0 22px;overflow:hidden}.bar b{display:block;height:5px;border-radius:5px;background:linear-gradient(90deg,#1a56ff,#0a2463);width:$PCT%}
ul{list-style:none;margin:0;padding:0;display:flex;justify-content:center;gap:6px}
li{width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:16px;color:#b2bcd2}
li.d{color:#1a56ff}li.c{color:#d62839}li.f{color:#d62839}
.cap{margin-top:18px;font-weight:700;font-size:11px;letter-spacing:.3em;padding-left:.3em;color:#1a56ff;min-height:14px}
.nm{margin-top:6px;font-weight:700;font-size:22px;line-height:1.2;min-height:30px}
.msg{margin-top:20px;font-size:14px}
</style></head><body><header>
<div class="badge"><img src="data:image/png;base64,$LOGO" alt=""></div>
<h1><span>ASO Companion</span></h1>
<div class="k">AMERICAN SPACE OUJDA</div>
</header><main>
<p>It takes about 5 to 10 minutes. Leave this page and the Terminal window open.</p>
<div class="bar"><b></b></div>
<ul>$rows</ul>
<div class="cap">$cap</div><div class="nm">$curname</div>
<p class="msg">$MSG</p>
</main></body></html>
HTML
}
mark() { STATE[$1]=$2; render; }
stop() {
  for i in "${!STATE[@]}"; do [ "${STATE[$i]}" = "a" ] && STATE[$i]=f; done
  MSG="Something went wrong: $1 The details are in $LOG."; DONE=1; render
  echo
  echo "Something went wrong: $1"
  echo "The details are in the file $LOG. Send that file to the developer."
  osascript -e "display dialog \"Something went wrong: $1\" buttons {\"OK\"} default button 1 with title \"ASO Companion setup\" with icon stop" >/dev/null 2>&1
  read -n 1 -s -r -p "Press any key to close."
  exit 1
}

clear
printf '\n  \033[1;34mASO Companion\033[0m\n'
printf '  \033[2mAmerican Space Oujda, setup on this computer\033[0m\n'
printf '  \033[2mIt takes about 5 to 10 minutes. Leave this window open.\033[0m\n'
echo

# ---- the token ----
TOKEN=$(osascript -e 'text returned of (display dialog "Paste the GitHub token here, then press OK:" default answer "" with title "ASO Companion setup" buttons {"Cancel", "OK"} default button "OK")' 2>/dev/null)
[ -z "$TOKEN" ] && { echo "No token entered. Nothing was installed."; exit 0; }
TOKEN=$(printf '%s' "$TOKEN" | tr -d '[:space:]')

open "$PAGE" >/dev/null 2>&1
mark 0 a; MSG="Checking the token..."; render
say "Checking the token..."
CODE=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $TOKEN" -H "User-Agent: aso-setup" "https://api.github.com/repos/$REPO")
[ "$CODE" = "200" ] || stop "GitHub did not accept this token (code $CODE). Check that it is copied completely."
mark 0 d; say "  token accepted"

# ---- Git (the Mac offers its own developer tools) ----
if ! xcode-select -p >/dev/null 2>&1 || ! command -v git >/dev/null 2>&1; then
  mark 1 a; MSG="A Mac window asks about developer tools. Press Install there, then wait."; render
  say "Installing Git. A Mac window asks about developer tools: press Install, then wait here."
  xcode-select --install >/dev/null 2>&1
  for i in $(seq 1 360); do
    xcode-select -p >/dev/null 2>&1 && command -v git >/dev/null 2>&1 && break
    sleep 5
  done
  command -v git >/dev/null 2>&1 || stop "Git was not installed. Run this setup again after installing the developer tools."
fi
mark 1 d; say "  Git is ready"

# ---- Node.js ----
if ! command -v node >/dev/null 2>&1; then
  mark 2 a; MSG="The Mac asks for your password once."; render
  say "Installing Node.js. The Mac asks for your password once."
  JSON=$(curl -s https://nodejs.org/dist/index.json) || stop "Could not reach nodejs.org."
  VER=$(printf '%s' "$JSON" | python3 -c "import sys,json; print(next(r['version'] for r in json.load(sys.stdin) if r['lts']))" 2>/dev/null)
  [ -n "$VER" ] || stop "Could not find the current Node.js version."
  PKG="/tmp/aso-node.pkg"
  curl -sL -o "$PKG" "https://nodejs.org/dist/$VER/node-$VER.pkg" || stop "Could not download Node.js."
  osascript -e "do shell script \"installer -pkg $PKG -target /\" with administrator privileges" >> "$LOG" 2>&1 || stop "Node.js was not installed."
  export PATH="/usr/local/bin:$PATH"
  command -v node >/dev/null 2>&1 || stop "Node.js was not installed."
fi
mark 2 d; PCT=35; say "  Node.js is ready"

# ---- the app ----
B64=$(printf 'x-access-token:%s' "$TOKEN" | base64 | tr -d '\n')
AUTH=(-c credential.helper= -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $B64")
if [ -d "$DIR/.git" ]; then
  mark 3 a; say "Updating the app..."
  git -C "$DIR" "${AUTH[@]}" pull --ff-only origin main >> "$LOG" 2>&1 || stop "The app could not be updated."
else
  mark 3 a; MSG="Downloading the app..."; render
  say "Downloading the app..."
  git "${AUTH[@]}" clone "https://github.com/$REPO.git" "$DIR" >> "$LOG" 2>&1 || stop "The app could not be downloaded. Check that the token is allowed to read the repository."
fi
mark 3 d; PCT=50; say "  app downloaded"
cd "$DIR" || stop "The app folder is missing."

if [ ! -f .env.local ]; then
  SECRET=$(LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 64)
  cat > .env.local <<ENV
ASO_LOCAL=1
ASO_SESSION_SECRET=$SECRET
GITHUB_PAT=$TOKEN
GITHUB_REPO=$REPO
GITHUB_BRANCH=main
META_APP_ID=
META_APP_SECRET=
ENV
  chmod 600 .env.local
  say "  settings file written"
fi

mark 4 a; MSG="Installing the app parts. This takes a few minutes."; render
say "Installing the app parts (a few minutes)..."
npm install --no-audit --no-fund >> "$LOG" 2>&1 || stop "The app parts could not be installed."
mark 4 d; PCT=75; say "  parts installed"
mark 5 a; MSG="Building the app. This takes a few minutes."; render
say "Building the app (a few minutes)..."
npx next build >> "$LOG" 2>&1 || stop "The app could not be built."
git rev-parse HEAD > .next/aso-built.txt 2>/dev/null
mark 5 d; PCT=92; say "  app built"
mark 6 a

# the menu-bar icon is built now too, so the first start is quick
if command -v swiftc >/dev/null 2>&1; then
  mkdir -p .aso
  say "Preparing the menu-bar icon..."
  swiftc -O ASO-Tray.swift -o ".aso/ASO Companion" >> "$LOG" 2>&1 || say "  (the menu-bar icon was skipped)"
fi

chmod +x "ASO Companion.app/Contents/MacOS/ASO Companion" Start-ASO.command 2>/dev/null
xattr -dr com.apple.quarantine "$DIR" 2>/dev/null
osascript -e "tell application \"Finder\" to make alias file to POSIX file \"$DIR/ASO Companion.app\" at desktop" >/dev/null 2>&1

mark 6 d; PCT=100; MSG="All done. ASO Companion opens now."; DONE=1; render
echo
say "All done. ASO Companion opens now."
open "$DIR/ASO Companion.app"
sleep 4
