# ASO Companion on the director's computer. Start-ASO.bat makes the real file (.env.local) from this on the first start.
ASO_LOCAL=1
# any long random text; it signs the admin sign-in and locks the saved Facebook connection
ASO_SESSION_SECRET=
# a GitHub token that may read and write this repository (see LOCAL.md); the app saves the data with it
GITHUB_PAT=
GITHUB_REPO=justkhalid/aso-companion
GITHUB_BRANCH=main
# Facebook and Instagram (optional, see DEPLOY.md): lets "Connect with Facebook" and pasted tokens become lasting
META_APP_ID=
META_APP_SECRET=
