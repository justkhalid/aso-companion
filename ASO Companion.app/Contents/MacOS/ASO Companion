#!/bin/bash
# ASO Companion for Mac: double-click the app. No Terminal window.
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR" || exit 1

up() { curl -s -m 2 -o /dev/null -w "%{http_code}" http://localhost:3000/api/session 2>/dev/null | grep -q 200; }
note() { osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with title \"ASO Companion\"" >/dev/null 2>&1; }

open_app() {
  if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app=http://localhost:3000/admin
  else
    open http://localhost:3000/admin
  fi
}

if ! up; then
  if ! command -v node >/dev/null 2>&1; then
    note "Node.js is not installed on this Mac. The download page opens now. Install the LTS version, then open ASO Companion again."
    open https://nodejs.org/en/download
    exit 1
  fi
  if [ ! -f .env.local ]; then
    TOK=$(osascript -e 'text returned of (display dialog "First start. Paste the GitHub token here (LOCAL.md explains how to make it):" default answer "" with title "ASO Companion")' 2>/dev/null)
    [ -z "$TOK" ] && exit 0
    SECRET=$(LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 64)
    cat > .env.local <<ENV
ASO_LOCAL=1
ASO_SESSION_SECRET=$SECRET
GITHUB_PAT=$TOK
GITHUB_REPO=justkhalid/aso-companion
GITHUB_BRANCH=main
META_APP_ID=
META_APP_SECRET=
ENV
  fi
  rm -f aso-failed.txt
  osascript -e 'display notification "Getting ready. The first time takes a few minutes. The app opens by itself." with title "ASO Companion"' >/dev/null 2>&1
  (
    while true; do
      HEAD=$(git rev-parse HEAD 2>/dev/null)
      BUILT=$(cat .next/aso-built.txt 2>/dev/null)
      if [ ! -d node_modules ] || [ ! -f .next/BUILD_ID ] || [ "$HEAD" != "$BUILT" ]; then
        echo "[$(date)] installing and building" >> aso.log
        npm install --no-audit --no-fund >> aso.log 2>&1 || { echo failed > aso-failed.txt; exit 1; }
        npx next build >> aso.log 2>&1 || { echo failed > aso-failed.txt; exit 1; }
        [ -n "$HEAD" ] && echo "$HEAD" > .next/aso-built.txt
      fi
      echo "[$(date)] starting" >> aso.log
      npx next start -p 3000 >> aso.log 2>&1
      [ $? -eq 3 ] && continue
      exit 0
    done
  ) >/dev/null 2>&1 &
  disown 2>/dev/null
  tries=0
  until up; do
    sleep 3
    tries=$((tries+1))
    if [ -f aso-failed.txt ]; then note "The app could not start. The reason is in the file aso.log in the app folder. Send it to the developer."; exit 1; fi
    if [ $tries -gt 600 ]; then note "The app is taking too long to start. Check the file aso.log in the app folder."; exit 1; fi
  done
fi

# a Desktop icon, made once
if [ ! -e "$HOME/Desktop/ASO Companion" ] && [ ! -e "$HOME/Desktop/ASO Companion.app" ]; then
  osascript -e "tell application \"Finder\" to make alias file to POSIX file \"$APP_DIR/ASO Companion.app\" at desktop" >/dev/null 2>&1
fi
open_app
