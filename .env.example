# ASO Companion - environment variables
# Copy this file to .env and fill in the values, or set them in Vercel.

# PRIMARY STORAGE (recommended): Vercel Blob.
# Create a Blob store in the Vercel dashboard (Storage -> Create Database ->
# Blob) and connect it to this project. Vercel fills this variable
# automatically. When it is set, all app data lives on Vercel:
# saves are instant, never create git commits, and never trigger redeploys.
BLOB_READ_WRITE_TOKEN=

# LEGACY FALLBACK: GitHub. Only used while BLOB_READ_WRITE_TOKEN is not set.
# The PAT lets /api/sync commit data/state.json to the repo (server-side
# only, never exposed to the browser). Once Blob is connected, GitHub is
# code-only: no data commits, no GitHub Pages.
GITHUB_PAT=

# GitHub repo (owner/name), branch and state file path used by the fallback.
# Defaults: justkhalid/aso-companion, main, data/state.json
GITHUB_REPO=justkhalid/aso-companion
GITHUB_BRANCH=main
GITHUB_STATE_PATH=data/state.json

# Local SQLite database (sandbox only, not used on Vercel)
DATABASE_URL=file:/home/z/my-project/db/custom.db
