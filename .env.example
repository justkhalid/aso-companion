# ASO Companion - environment variables
# Copy this file to .env and fill in the values, or set them in Vercel.

# GitHub Personal Access Token used by /api/sync to save data/state.json
# to the repo (server-side only, never exposed to the browser).
GITHUB_PAT=

# GitHub repo (owner/name), branch and state file path.
# Defaults: justkhalid/aso-companion, main, data/state.json
GITHUB_REPO=justkhalid/aso-companion
GITHUB_BRANCH=main
GITHUB_STATE_PATH=data/state.json

# Local SQLite database (sandbox only, not used on Vercel)
DATABASE_URL=file:/home/z/my-project/db/custom.db
